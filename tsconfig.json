{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["skills", "harness", "evals", "test", "vitest.config.ts"],
  "exclude": ["**/node_modules", "fixtures", "evals/.runs", "evals/*/results", "**/out"]
}
